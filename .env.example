# Local development needs no credentials: it uses persistent embedded PostgreSQL.
# For Supabase, copy the Session pooler URL (port 5432) from Connect > ORMs.
# Use a dedicated project. Never put DATABASE_URL in a NEXT_PUBLIC_ variable.
DATABASE_URL=
# Set to the canonical deployed HTTPS origin in production.
APP_URL=http://localhost:3000
# Optional local database directory (ignored when DATABASE_URL is set).
LOCAL_DATABASE_PATH=.data/formly
